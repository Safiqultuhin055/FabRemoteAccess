# Fabulous Remote server: production configuration template.
# Copy to deploy\server\.env on the server, fill in locally, never commit it.

FR_ENV=production
FR_LOG_LEVEL=INFO
FR_LOG_FORMAT=json

# Long random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
FR_JWT_SIGNING_KEY=

# The https address clients use (also used in invitation links).
FR_PUBLIC_BASE_URL=https://<server-address>:300

# Landing page folder (absolute path on the server).
FR_SITE_DIR=C:\FabulousRemote\web\site

# --- SQL Server (application login only: never sa) --------------------------
FR_DB_HOST=<sql-server-host>
FR_DB_PORT=1433
FR_DB_NAME=FabRemotesDB
FR_DB_DRIVER=ODBC Driver 18 for SQL Server
FR_DB_USER=<application login (member of fr_app_runtime)>
FR_DB_PASSWORD=
FR_DB_ENCRYPT=yes
FR_DB_TRUST_SERVER_CERT=no
# If the SQL Server certificate is not trusted by this machine: pin it, and/or give its host name.
FR_DB_SERVER_CERTIFICATE=
FR_DB_HOST_NAME_IN_CERTIFICATE=

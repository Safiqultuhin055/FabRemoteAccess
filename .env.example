# Fabulous Remote configuration template.
# Copy to .env and fill in locally. Never commit .env or put real secrets or hosts in this file.

# development | test | staging | production
FR_ENV=development
FR_LOG_LEVEL=INFO
# json | text
FR_LOG_FORMAT=json
# Leave empty: OpenAPI docs are exposed only in development.
FR_EXPOSE_OPENAPI=
# Folder with the landing page to serve at "/" (e.g. the repository's web/site). Empty = not served.
FR_SITE_DIR=

# --- SQL Server (application runtime) ---------------------------------------
# The application connects ONLY with the runtime login (member of fr_app_runtime).
# Migrator and DBA credentials are never placed in the application's .env;
# migrations are run separately with sqlcmd (see docs/DATABASE_DESIGN.md).
FR_DB_HOST=
FR_DB_PORT=1433
FR_DB_NAME=FabRemotesDB
FR_DB_SCHEMA=fr
FR_DB_DRIVER=ODBC Driver 18 for SQL Server
# Least-privilege runtime login (never sa). Leave both empty to use Windows authentication.
FR_DB_USER=
FR_DB_PASSWORD=
FR_DB_ENCRYPT=yes
# "yes" disables certificate validation: honoured only with FR_ENV=development AND a local server.
FR_DB_TRUST_SERVER_CERT=no
# Optional, keeps validation on: path to the server's exported certificate (pinning, ODBC 18.1+)
# and/or the host name the certificate was issued to (needed when FR_DB_HOST is an IP address).
FR_DB_SERVER_CERTIFICATE=
FR_DB_HOST_NAME_IN_CERTIFICATE=
# Optional: @@SERVERNAME the inventory tool must find before it reads any metadata.
FR_DB_EXPECTED_SERVER=
FR_DB_LOGIN_TIMEOUT_SECONDS=5
FR_DB_QUERY_TIMEOUT_SECONDS=10
FR_DB_POOL_SIZE=5
FR_DB_MAX_OVERFLOW=5

# --- Data retention (days; fr.usp_purge_expired_data) -----------------------
# PROPOSED values pending owner/legal approval. Keep disabled outside development until approved.
FR_RETENTION_ENABLED=false
FR_RETENTION_SESSION_DAYS=365
FR_RETENTION_REQUEST_DAYS=90
FR_RETENTION_AUDIT_DAYS=365
FR_RETENTION_IP_DAYS=90

# --- Local database tests (LocalDB only; tests refuse any other server) ------
FR_TEST_SQL_SERVER=(localdb)\FabRemoteTest

# --- Backend (Phase 3) ------------------------------------------------------
# At least 32 random bytes. Required outside development/test; if empty in development an
# ephemeral key is generated at startup (all tokens become invalid on restart).
FR_JWT_SIGNING_KEY=
FR_ACCESS_TOKEN_TTL_SECONDS=600
FR_REFRESH_TOKEN_TTL_DAYS=30
FR_WEB_SESSION_IDLE_HOURS=12
FR_WEB_SESSION_ABSOLUTE_DAYS=7
FR_LOGIN_LOCKOUT_THRESHOLD=10
FR_LOGIN_LOCKOUT_MINUTES=15
# Base URL for invitation links (https; http://localhost allowed in development).
FR_PUBLIC_BASE_URL=
# Devices: challenge lifetime, presence expiry (online only if a verified heartbeat is this recent), limit.
FR_DEVICE_CHALLENGE_TTL_SECONDS=120
FR_PRESENCE_TTL_SECONDS=90
FR_MAX_DEVICES_PER_USER=10
# Device-only token lifetime (obtained by signing a challenge with the device key; no account needed).
FR_DEVICE_TOKEN_TTL_SECONDS=600
# Connection requests: seconds the target has to Accept; a session ends when either side is silent this long.
FR_CONNECTION_REQUEST_TTL_SECONDS=45
FR_SESSION_PRESENCE_TIMEOUT_SECONDS=30
# Comma-separated explicit origins; leave empty for same-origin only.
FR_CORS_ALLOWED_ORIGINS=

# --- TURN (Phase 6+) --------------------------------------------------------
FR_TURN_URLS=
FR_TURN_SHARED_SECRET=
FR_TURN_CREDENTIAL_TTL_SECONDS=600
